{
  "family": "sunsaver-etl-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::610140802215:role/ecsTaskExecutionRole",
  "taskRoleArn":      "arn:aws:iam::610140802215:role/sunsaver-etl-task-role",
  "containerDefinitions": [
    {
      "name":      "sunsaver-etl",
      "image":     "610140802215.dkr.ecr.eu-south-2.amazonaws.com/sunsaver-etl:latest",
      "essential": true,

      "environment": [
        { "name": "AWS_REGION",    "value": "eu-south-2"         },
        { "name": "S3_BUCKET",     "value": "sunsaver-bronze-dev" },
        { "name": "BRONZE_PREFIX", "value": "bronze/"             },
        { "name": "ENVIRONMENT",   "value": "PRD"}
      ],

      "secrets": [
        { "name": "DB_USER",         "valueFrom": "arn:aws:ssm:eu-south-2:610140802215:parameter/sunsaver/dev/DB_USER"         },
        { "name": "DB_PASS",         "valueFrom": "arn:aws:ssm:eu-south-2:610140802215:parameter/sunsaver/dev/DB_PASS"         },
        { "name": "DB_HOST",         "valueFrom": "arn:aws:ssm:eu-south-2:610140802215:parameter/sunsaver/dev/DB_HOST"         },
        { "name": "DB_NAME",         "valueFrom": "arn:aws:ssm:eu-south-2:610140802215:parameter/sunsaver/dev/DB_NAME"         },
        { "name": "DB_PORT",         "valueFrom": "arn:aws:ssm:eu-south-2:610140802215:parameter/sunsaver/dev/DB_PORT"         },
        { "name": "ESIOS_API_KEY",   "valueFrom": "arn:aws:ssm:eu-south-2:610140802215:parameter/sunsaver/dev/ESIOS_API_KEY"   },
        { "name": "WEATHER_API_KEY", "valueFrom": "arn:aws:ssm:eu-south-2:610140802215:parameter/sunsaver/dev/WEATHER_API_KEY" }
      ],

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/sunsaver-etl",
          "awslogs-region":        "eu-south-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group":  "true"
        }
      }
    }
  ]
}